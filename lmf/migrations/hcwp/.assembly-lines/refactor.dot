digraph refactor {
  start -> planner
  planner -> task-context [label="not complete"]
  planner -> finish [label="complete"]
  task-context -> review-context
  review-context -> planner [label="not ready"]
  review-context -> plan-review-dispatch [label="ready"]
  plan-review-dispatch -> plan-review-gpt-sol
  plan-review-dispatch -> plan-review-claude-opus
  plan-review-dispatch -> plan-review-kimi
  plan-review-gpt-sol -> plan-review-synthesiser
  plan-review-claude-opus -> plan-review-synthesiser
  plan-review-kimi -> plan-review-synthesiser
  plan-review-synthesiser -> planner [label="not satisfied"]
  plan-review-synthesiser -> doer [label="satisfied"]
  // OpenRouter code-review fan-out is temporarily disabled.
  doer -> architecture-review
  architecture-review -> doer [label="not satisfied"]
  architecture-review -> behavioural-parity [label="satisfied"]
  behavioural-parity -> doer [label="not satisfied"]
  behavioural-parity -> delivery-review [label="satisfied"]
  delivery-review -> doer [label="not satisfied"]
  delivery-review -> nhsw-design-review [label="satisfied"]
  nhsw-design-review -> doer [label="not satisfied"]
  nhsw-design-review -> planner [label="satisfied"]
}
