#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
cd "$here/.."
python3 refactor/check-prerequisites.py > refactor/evidence/nhsw-prerequisites.json
printf '%s\n' \
 '117106cd1129ddfc0dae636d123d9123583c8f3970ebad63e2295d63bb502d99  refactor/src/wwwroot/vendor/nhsw/nhsw.min.css' \
 '0a657e4e9df62b5286ded60d036205904cc1ab1194f2e812f873848267fc114a  refactor/src/wwwroot/vendor/nhsw/LICENSE' | sha256sum --check > refactor/evidence/nhsw-checksums.log
dotnet build refactor/src/Hcwp.csproj > refactor/evidence/nhsw-build.log 2>&1
if curl -fsS http://127.0.0.1:5187/ -o /dev/null 2>/dev/null; then
  echo 'Port 5187 already serves HTTP; stop it first' >&2
  exit 1
fi
dotnet run --no-build --project refactor/src/Hcwp.csproj --urls http://127.0.0.1:5187 > refactor/evidence/nhsw-browser-server.log 2>&1 &
server=$!
trap 'kill "$server" 2>/dev/null || true; wait "$server" 2>/dev/null || true' EXIT
ready=false
for i in $(seq 1 100); do
  if curl -fsS http://127.0.0.1:5187/ -o /dev/null 2>/dev/null; then ready=true; break; fi
  sleep .2
done
if [ "$ready" != true ]; then echo 'App failed to start' >&2; exit 1; fi
node refactor/browser/nhsw.mjs > refactor/evidence/nhsw-browser.log 2>&1
