#!/usr/bin/env python3
"""Execute the bounded verification task; never update the external plan."""
import hashlib
import json
from pathlib import Path
import subprocess
from datetime import datetime, timezone

here = Path(__file__).resolve().parent
root = here.parent
out = here / 'evidence'
report = {'startedAt': datetime.now(timezone.utc).isoformat(), 'failed': 0, 'skipped': 0, 'checks': []}
try:
    for name, command in [
        ('prerequisites-before', ['python3', 'refactor/check-prerequisites.py']),
        ('style', ['refactor/verify-style']),
        ('flow', ['refactor/verify-flow']),
        ('parity', ['refactor/run-approved-scenarios']),
        ('prerequisites-after', ['python3', 'refactor/check-prerequisites.py']),
    ]:
        path = out / f'gate-{name}.log'
        with path.open('w') as log:
            subprocess.run(command, cwd=root, stdout=log, stderr=subprocess.STDOUT, check=True)
        report['checks'].append({'name': name, 'status': 'passed', 'log': str(path.relative_to(here))})
    for name, count in [('full-flow-model.json', 4), ('full-flow-persistence.json', 4), ('full-flow-regression/results.json', 40), ('full-flow-browser/results.json', 6)]:
        result = json.loads((out / name).read_text())
        assert result['passed'] == count and result['failed'] == result['skipped'] == 0, name
        if 'browser' in name:
            assert result['browserExecuted'] and not result['runtimeErrors']
        report['checks'].append({'name': name, 'passed': count, 'failed': 0, 'skipped': 0})
    build = (out / 'full-flow-build.log').read_text()
    assert '0 Warning(s)' in build and '0 Error(s)' in build
except Exception as error:
    report['failed'] = 1
    report['error'] = str(error)
finally:
    report['finishedAt'] = datetime.now(timezone.utc).isoformat()
    report['evidenceSha256'] = {}
    for path in sorted(out.rglob('*')):
        # The caller's redirected transcript is still open when this inventory is made.
        if path.is_file() and path.name not in ('gate-results.json', 'gate-run.log'):
            report['evidenceSha256'][str(path.relative_to(here))] = hashlib.sha256(path.read_bytes()).hexdigest()
    report['sourceSha256'] = {}
    for path in sorted(here.rglob('*')):
        if path.is_file() and not any(part in ('evidence', 'obj', 'bin', 'node_modules', '.parity-run') for part in path.relative_to(here).parts):
            report['sourceSha256'][str(path.relative_to(here))] = hashlib.sha256(path.read_bytes()).hexdigest()
    (out / 'gate-results.json').write_text(json.dumps(report, indent=2) + '\n')
    print(json.dumps({k: v for k, v in report.items() if not k.endswith('Sha256')}))
raise SystemExit(1 if report['failed'] else 0)
