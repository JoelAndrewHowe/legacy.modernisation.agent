@inherits LocalizedComponent
@foreach (var group in ResultDisplay.Groups)
{
    <section aria-label="@T(group.Title)">
        <h2 class="nhsw-h2">@T(group.Title)</h2>
        <dl class="nhsw-summary-list nhsw-summary-list--no-border">
            @if (group.Title == "Contact details")
            {
                <div class="nhsw-summary-list__row"><dt class="nhsw-summary-list__key">@T("Contact type")</dt><dd class="nhsw-summary-list__value">@T("6–8-week contact")</dd></div>
                <div class="nhsw-summary-list__row"><dt class="nhsw-summary-list__key">@T("Examination state")</dt><dd class="nhsw-summary-list__value">@T(Result.ReasonNotExamined == null ? "Recorded" : "Not examined")</dd></div>
                <div class="nhsw-summary-list__row"><dt class="nhsw-summary-list__key">@T("Initial or repeat")</dt><dd class="nhsw-summary-list__value">@T(Result.IsRepeat ? "Repeat" : "Initial")</dd></div>
            }
            @foreach (var field in RecordingFields.All.Where(f => group.Properties.Contains(f.Property)))
            {
                <div class="nhsw-summary-list__row"><dt class="nhsw-summary-list__key">@T(ResultDisplay.Label(field))</dt><dd class="nhsw-summary-list__value">@T(ResultDisplay.Field(Result, field))</dd></div>
            }
            @if (group.Title == "Measurements")
            {
                <div class="nhsw-summary-list__row"><dt class="nhsw-summary-list__key">@T("Calculated BMI")</dt><dd class="nhsw-summary-list__value">@(ResultDisplay.Bmi(Result)?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? T("Not available"))</dd></div>
            }
            @if (group.Title == "Recording metadata")
            {
                <div class="nhsw-summary-list__row"><dt class="nhsw-summary-list__key">@T("Recorded date")</dt><dd class="nhsw-summary-list__value">@ResultDisplay.Date(Hcwp.Application.Kd03ResultsQuery.RecordedDate(Result))</dd></div>
            }
        </dl>
    </section>
}
@code {
    [Parameter, EditorRequired] public Orvex.TransferObjects.KdpExaminationResultTO Result { get; set; }
}
