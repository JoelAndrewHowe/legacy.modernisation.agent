@foreach (var group in ResultDisplay.Groups)
{
    <section aria-label="@group.Title">
        <h2 class="nhsw-h2">@group.Title</h2>
        <dl class="nhsw-summary-list nhsw-summary-list--no-border">
            @if (group.Title == "Contact details")
            {
                <div class="nhsw-summary-list__row"><dt class="nhsw-summary-list__key">Contact type</dt><dd class="nhsw-summary-list__value">6–8-week contact</dd></div>
                <div class="nhsw-summary-list__row"><dt class="nhsw-summary-list__key">Examination state</dt><dd class="nhsw-summary-list__value">@(Result.ReasonNotExamined == null ? "Recorded" : "Not examined")</dd></div>
                <div class="nhsw-summary-list__row"><dt class="nhsw-summary-list__key">Initial or repeat</dt><dd class="nhsw-summary-list__value">@(Result.IsRepeat ? "Repeat" : "Initial")</dd></div>
            }
            @foreach (var field in RecordingFields.All.Where(f => group.Properties.Contains(f.Property)))
            {
                <div class="nhsw-summary-list__row"><dt class="nhsw-summary-list__key">@ResultDisplay.Label(field)</dt><dd class="nhsw-summary-list__value">@ResultDisplay.Field(Result, field)</dd></div>
            }
            @if (group.Title == "Measurements")
            {
                <div class="nhsw-summary-list__row"><dt class="nhsw-summary-list__key">Calculated BMI</dt><dd class="nhsw-summary-list__value">@(ResultDisplay.Bmi(Result)?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "Not available")</dd></div>
            }
            @if (group.Title == "Recording metadata")
            {
                <div class="nhsw-summary-list__row"><dt class="nhsw-summary-list__key">Recorded date</dt><dd class="nhsw-summary-list__value">@ResultDisplay.Date(Hcwp.Application.Kd03ResultsQuery.RecordedDate(Result))</dd></div>
            }
        </dl>
    </section>
}
@code {
    [Parameter, EditorRequired] public Orvex.TransferObjects.KdpExaminationResultTO Result { get; set; }
}
