@page "/"
@inject RecordingPageModel Model
<PageTitle>Synthetic KD03 recording</PageTitle>
<main class="nhsw-main-wrapper" id="maincontent">
    <div class="nhsw-width-container">
    <h1 class="nhsw-h1">6–8-week contact (KD03)</h1>
    <p>Architecture preview only. Synthetic patient 101, born 1 January 2025.</p>
    <p>Fixed demonstration clock: 15 March 2025. Temporary in-memory data; not clinical policy.</p>
    @if (Model.Error != null)
    {
        <section class="nhsw-error-summary" role="alert" aria-labelledby="error-title" tabindex="-1">
            <h2 class="nhsw-h3 nhsw-error-summary__title" id="error-title">Result not saved</h2>
            <p>@Model.Error</p>
        </section>
    }
    <EditForm Model="Model" OnSubmit="Model.Save" FormName="kd03">
        <div class="nhsw-form-group">
            <label class="nhsw-label" for="contact-date">Contact date</label>
            <div class="nhsw-hint" id="contact-date-hint">Use the date of the contact, not the date entered.</div>
            <InputDate class="nhsw-input nhsw-input--width-10" id="contact-date" aria-describedby="contact-date-hint" @bind-Value="Model.Date" />
        </div>
        <div class="nhsw-form-group">
            <label class="nhsw-label" for="heart">Heart assessment</label>
            <InputSelect class="nhsw-select" id="heart" @bind-Value="Model.Heart">
                <option value="">Not recorded</option>
                <option value="1">Satisfactory</option>
                <option value="2">Concern</option>
                <option value="3">Not assessed</option>
            </InputSelect>
        </div>
        <button class="nhsw-button nhsw-button--primary nhsw-button--inline" type="submit">Save KD03 result</button>
    </EditForm>
    <h2 class="nhsw-h2">Saved results for patient 101</h2>
    <button class="nhsw-button nhsw-button--secondary nhsw-button--inline" type="button" @onclick="Model.Reload">Reload from persistence</button>
    @if (Model.Results.Count == 0)
    {
        <p>No saved KD03 results.</p>
    }
    @foreach (var result in Model.Results)
    {
        <dl class="nhsw-summary-list nhsw-summary-list--no-border">
            <div class="nhsw-summary-list__row">
                <dt class="nhsw-summary-list__key">Result ID</dt><dd class="nhsw-summary-list__value">@result.PkChildExaminationId</dd>
            </div>
            <div class="nhsw-summary-list__row">
                <dt class="nhsw-summary-list__key">Patient ID</dt><dd class="nhsw-summary-list__value">@result.ClientId</dd>
            </div>
            <div class="nhsw-summary-list__row">
                <dt class="nhsw-summary-list__key">Date</dt><dd class="nhsw-summary-list__value">@result.ExaminationDate.ToString("yyyy-MM-dd")</dd>
            </div>
            <div class="nhsw-summary-list__row">
                <dt class="nhsw-summary-list__key">Heart</dt><dd class="nhsw-summary-list__value">@result.Heart</dd>
            </div>
            <div class="nhsw-summary-list__row">
                <dt class="nhsw-summary-list__key">Repeat</dt><dd class="nhsw-summary-list__value">@result.IsRepeat</dd>
            </div>
        </dl>
    }
    <p>Other contacts, search, editing, appointments and recalls are not supported.</p>
    </div>
</main>
@code {
    protected override void OnInitialized() => Model.Reload();
}
