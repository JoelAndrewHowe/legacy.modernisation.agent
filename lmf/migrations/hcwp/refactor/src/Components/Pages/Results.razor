@page "/results"
@implements IDisposable
@using Hcwp.Application
@inject Kd03ResultsQuery Query
@inject NavigationManager Navigation
<PageTitle>HCWP results</PageTitle>
<h1 class="nhsw-h1">HCWP results</h1>
<p><a class="nhsw-button nhsw-button--primary nhsw-button--inline" href="/record">Record result</a></p>
@if (notices.Length > 0)
{
    <section class="nhsw-error-summary" role="alert" aria-labelledby="invalid-filters-title" tabindex="-1">
        <h2 class="nhsw-h3 nhsw-error-summary__title" id="invalid-filters-title">Invalid filters</h2>
        <ul class="nhsw-list nhsw-error-summary__list">
            @foreach (var notice in notices) { <li><a href="#results-filters" @onclick="FocusFilters" @onclick:preventDefault="true">@notice</a></li> }
        </ul>
    </section>
}
<form action="/results" method="get" data-enhance="false" data-ready="@ready.ToString().ToLowerInvariant()">
    <fieldset class="nhsw-fieldset" disabled="@(!ready)"><legend class="nhsw-fieldset__legend nhsw-h2" id="results-filters" tabindex="-1" @ref="filterHeading">Filter results</legend>
    <div class="nhsw-form-group">
        <fieldset class="nhsw-fieldset"><legend class="nhsw-fieldset__legend nhsw-h3">Examination state</legend>
            <div class="nhsw-checkboxes">
                @foreach (var value in Enum.GetValues<ExaminationState>())
                {
                    <div class="nhsw-checkboxes__item">
                        <input class="nhsw-checkboxes__input" id="@($"state-{value}")" type="checkbox" name="state" value="@value" checked="@filter.States.Contains(value)" />
                        <label class="nhsw-label nhsw-checkboxes__label" for="@($"state-{value}")">@(value == ExaminationState.Recorded ? "Recorded" : "Not examined")</label>
                    </div>
                }
            </div>
        </fieldset>
    </div>
    <div class="nhsw-form-group">
        <fieldset class="nhsw-fieldset"><legend class="nhsw-fieldset__legend nhsw-h3">Initial or repeat</legend>
            <div class="nhsw-checkboxes">
                <div class="nhsw-checkboxes__item">
                    <input class="nhsw-checkboxes__input" id="repeat-initial" type="checkbox" name="repeat" value="initial" checked="@filter.Repeats.Contains(false)" />
                    <label class="nhsw-label nhsw-checkboxes__label" for="repeat-initial">Initial</label>
                </div>
                <div class="nhsw-checkboxes__item">
                    <input class="nhsw-checkboxes__input" id="repeat-repeat" type="checkbox" name="repeat" value="repeat" checked="@filter.Repeats.Contains(true)" />
                    <label class="nhsw-label nhsw-checkboxes__label" for="repeat-repeat">Repeat</label>
                </div>
            </div>
        </fieldset>
    </div>
    <div class="nhsw-form-group">
        <fieldset class="nhsw-fieldset"><legend class="nhsw-fieldset__legend nhsw-h3">Physical finding</legend>
            <div class="nhsw-checkboxes">
                @foreach (var value in Enum.GetValues<PhysicalFinding>())
                {
                    <div class="nhsw-checkboxes__item">
                        <input class="nhsw-checkboxes__input" id="@($"finding-{value}")" type="checkbox" name="finding" value="@value" checked="@filter.Findings.Contains(value)" />
                        <label class="nhsw-label nhsw-checkboxes__label" for="@($"finding-{value}")">@FindingLabel(value)</label>
                    </div>
                }
            </div>
        </fieldset>
    </div>
    <div class="nhsw-form-group">
        <fieldset class="nhsw-fieldset"><legend class="nhsw-fieldset__legend nhsw-h3">Inclusive contact-date range</legend>
            <div class="nhsw-form-group">
                <label class="nhsw-label" for="from">From contact date</label>
                <input class="nhsw-input nhsw-input--width-10" id="from" name="from" type="date" value="@filter.From?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="nhsw-form-group">
                <label class="nhsw-label" for="to">To contact date</label>
                <input class="nhsw-input nhsw-input--width-10" id="to" name="to" type="date" value="@filter.To?.ToString("yyyy-MM-dd")" />
            </div>
        </fieldset>
    </div>
    <div class="nhsw-form-group">
        <fieldset class="nhsw-fieldset"><legend class="nhsw-fieldset__legend nhsw-h3">Location</legend>
            <div class="nhsw-checkboxes">
                @foreach (var c in choices.Locations)
                {
                    <div class="nhsw-checkboxes__item">
                        <input class="nhsw-checkboxes__input" id="@($"location-{c.Code}")" type="checkbox" name="location" value="@c.Code" checked="@filter.Locations.Contains(c.Code)" />
                        <label class="nhsw-label nhsw-checkboxes__label" for="@($"location-{c.Code}")">@c.Description</label>
                    </div>
                }
            </div>
        </fieldset>
    </div>
    <div class="nhsw-form-group">
        <fieldset class="nhsw-fieldset"><legend class="nhsw-fieldset__legend nhsw-h3">Examiner</legend>
            <div class="nhsw-checkboxes">
                @foreach (var c in choices.Examiners)
                {
                    <div class="nhsw-checkboxes__item">
                        <input class="nhsw-checkboxes__input" id="@($"examiner-{c.Code}")" type="checkbox" name="examiner" value="@c.Code" checked="@filter.Examiners.Contains(c.Code)" />
                        <label class="nhsw-label nhsw-checkboxes__label" for="@($"examiner-{c.Code}")">@c.Description</label>
                    </div>
                }
            </div>
        </fieldset>
    </div>
    <div class="nhsw-form-group">
        <label class="nhsw-label" for="size">Results per page</label>
        <select class="nhsw-select" id="size" name="size">@foreach (var size in new[] { 10, 25, 50 }) { <option value="@size" selected="@(filter.PageSize == size)">@size</option> }</select>
    </div>
    <button class="nhsw-button nhsw-button--primary nhsw-button--inline" type="submit">Apply filters and page size</button>
    <a class="nhsw-link" href="/results">Clear all filters</a>
    </fieldset>
</form>
<section aria-labelledby="active-filters"><h2 id="active-filters" class="nhsw-h3">Active filters</h2><p>@Summary()</p></section>
<p role="status">Showing @results.First–@results.Last of @results.Total results.</p>
@if (results.Total == 0)
{
    <p>@(Summary() == "None" ? "No saved KD03 results for the selected patient." : "No saved KD03 results match the selected filters.")</p>
}
else
{
    @foreach (var result in results.Rows)
    {
        <article aria-label="@($"6–8-week contact on {ResultDisplay.Date(result.ExaminationDate)}")">
            <h2 class="nhsw-h3">@ResultDisplay.Date(result.ExaminationDate) — 6–8-week contact</h2>
            <dl class="nhsw-summary-list nhsw-summary-list--no-border">
                <div class="nhsw-summary-list__row"><dt class="nhsw-summary-list__key">Examination state</dt><dd class="nhsw-summary-list__value">@(result.ReasonNotExamined == null ? "Recorded" : "Not examined")</dd></div>
                <div class="nhsw-summary-list__row"><dt class="nhsw-summary-list__key">Location</dt><dd class="nhsw-summary-list__value">@PatientBannerValues.Present(result.LocationName)</dd></div>
                <div class="nhsw-summary-list__row"><dt class="nhsw-summary-list__key">Examiner</dt><dd class="nhsw-summary-list__value">@PatientBannerValues.Present(result.ExaminerName)</dd></div>
                <div class="nhsw-summary-list__row"><dt class="nhsw-summary-list__key">Initial or repeat</dt><dd class="nhsw-summary-list__value">@(result.IsRepeat ? "Repeat" : "Initial")</dd></div>
                <div class="nhsw-summary-list__row"><dt class="nhsw-summary-list__key">Recorded date</dt><dd class="nhsw-summary-list__value">@ResultDisplay.Date(Kd03ResultsQuery.RecordedDate(result))</dd></div>
            </dl>
            <p><a class="nhsw-link" href="@($"/results/{result.PkChildExaminationId}{Navigation.ToAbsoluteUri(ResultsUrlState.Url(filter)).Query}")">View details<span class="nhsw-visually-hidden"> for 6–8-week contact on @ResultDisplay.Date(result.ExaminationDate)</span></a></p>
        </article>
    }
    <nav class="nhsw-pagination nhsw-pagination--numbered" aria-label="Results pages">
        @if (results.Page > 1)
        {
            <a class="nhsw-pagination__previous" rel="prev" href="@ResultsUrlState.Url(filter, results.Page - 1)"><span class="nhsw-pagination__title">Previous page</span></a>
        }
        <ul class="nhsw-pagination__list">
            @for (var i = 1; i <= results.Pages; i++)
            {
                var page = i;
                <li class="@(page == results.Page ? "nhsw-pagination__item nhsw-pagination__item--current" : "nhsw-pagination__item")">
                    <a class="nhsw-pagination__number-link" aria-label="@($"Page {page}")" aria-current="@(page == results.Page ? "page" : null)" href="@ResultsUrlState.Url(filter, page)">@(page)</a>
                </li>
            }
        </ul>
        @if (results.Page < results.Pages)
        {
            <a class="nhsw-pagination__next" rel="next" href="@ResultsUrlState.Url(filter, results.Page + 1)"><span class="nhsw-pagination__title">Next page</span></a>
        }
    </nav>
}
@code {
    ElementReference filterHeading;
    async Task FocusFilters() => await filterHeading.FocusAsync();
    bool ready;
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { ready = true; StateHasChanged(); }
    }
    ResultsPage results;
    ResultsFilter filter = new();
    ResultsChoices choices;
    string[] notices = [];
    protected override void OnInitialized() => Navigation.LocationChanged += LocationChanged;
    void LocationChanged(object sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        _ = InvokeAsync(() => { Refresh(); StateHasChanged(); });
    }
    public void Dispose() => Navigation.LocationChanged -= LocationChanged;
    protected override void OnParametersSet() => Refresh();
    void Refresh()
    {
        choices = Query.Choices(RecordingPageModel.SelectedPatient);
        var state = ResultsUrlState.Parse(Navigation.Uri, choices);
        results = Query.Search(RecordingPageModel.SelectedPatient, state.Filter);
        notices = state.Notices;
        if (results.Page != state.Filter.Page) notices = [.. notices, "Page outside result range; showing the nearest valid page."];
        filter = state.Filter with { Page = results.Page };
    }
    static string FindingLabel(PhysicalFinding f) => f switch { PhysicalFinding.NotAssessed => "Not assessed", PhysicalFinding.HasConcern => "Has concern", _ => f.ToString() };
    string Summary()
    {
        var parts = new List<string>();
        parts.AddRange(filter.States.Select(v => v == ExaminationState.Recorded ? "Recorded" : "Not examined"));
        parts.AddRange(filter.Repeats.Select(v => v ? "Repeat" : "Initial"));
        parts.AddRange(filter.Findings.Select(FindingLabel));
        parts.AddRange(choices.Locations.Where(c => filter.Locations.Contains(c.Code)).Select(c => "Location: " + c.Description));
        parts.AddRange(choices.Examiners.Where(c => filter.Examiners.Contains(c.Code)).Select(c => "Examiner: " + c.Description));
        if (filter.From.HasValue) parts.Add("From: " + ResultDisplay.Date(filter.From.Value.ToDateTime(TimeOnly.MinValue)));
        if (filter.To.HasValue) parts.Add("To: " + ResultDisplay.Date(filter.To.Value.ToDateTime(TimeOnly.MinValue)));
        return parts.Count == 0 ? "None" : string.Join("; ", parts);
    }
}
