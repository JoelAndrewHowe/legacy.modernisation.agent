@page "/results"
@inherits LocalizedComponent
@using Hcwp.Application
@inject Kd03ResultsQuery Query
@inject NavigationManager Navigation
<PageTitle>@T("HCWP results")</PageTitle>
<h1 class="nhsw-h1">@T("HCWP results")</h1>
<p><a class="nhsw-button nhsw-button--primary nhsw-button--inline" href="/record">@T("Record result")</a></p>
@if (notices.Length > 0)
{
    <section class="nhsw-error-summary" role="alert" aria-labelledby="invalid-filters-title" tabindex="-1">
        <h2 class="nhsw-h3 nhsw-error-summary__title" id="invalid-filters-title">@T("Invalid filters")</h2>
        <ul class="nhsw-list nhsw-error-summary__list">
            @foreach (var notice in notices) { <li><a href="#results-filters" @onclick="FocusFilters" @onclick:preventDefault="true">@Notice(notice)</a></li> }
        </ul>
    </section>
}
<form action="/results" method="get" data-enhance="false" data-ready="@ready.ToString().ToLowerInvariant()">
    <fieldset class="nhsw-fieldset" disabled="@(!ready)"><legend class="nhsw-fieldset__legend nhsw-h2" id="results-filters" tabindex="-1" @ref="filterHeading">@T("Filter results")</legend>
    <div class="nhsw-form-group">
        <fieldset class="nhsw-fieldset"><legend class="nhsw-fieldset__legend nhsw-h3">@T("Examination state")</legend>
            <div class="nhsw-checkboxes">
                @foreach (var value in Enum.GetValues<ExaminationState>())
                {
                    <div class="nhsw-checkboxes__item">
                        <input class="nhsw-checkboxes__input" id="@($"state-{value}")" type="checkbox" name="state" value="@value" checked="@filter.States.Contains(value)" />
                        <label class="nhsw-label nhsw-checkboxes__label" for="@($"state-{value}")">@T(value == ExaminationState.Recorded ? "Recorded" : "Not examined")</label>
                    </div>
                }
            </div>
        </fieldset>
    </div>
    <div class="nhsw-form-group">
        <fieldset class="nhsw-fieldset"><legend class="nhsw-fieldset__legend nhsw-h3">@T("Initial or repeat")</legend>
            <div class="nhsw-checkboxes">
                <div class="nhsw-checkboxes__item">
                    <input class="nhsw-checkboxes__input" id="repeat-initial" type="checkbox" name="repeat" value="initial" checked="@filter.Repeats.Contains(false)" />
                    <label class="nhsw-label nhsw-checkboxes__label" for="repeat-initial">@T("Initial")</label>
                </div>
                <div class="nhsw-checkboxes__item">
                    <input class="nhsw-checkboxes__input" id="repeat-repeat" type="checkbox" name="repeat" value="repeat" checked="@filter.Repeats.Contains(true)" />
                    <label class="nhsw-label nhsw-checkboxes__label" for="repeat-repeat">@T("Repeat")</label>
                </div>
            </div>
        </fieldset>
    </div>
    <div class="nhsw-form-group">
        <fieldset class="nhsw-fieldset"><legend class="nhsw-fieldset__legend nhsw-h3">@T("Physical finding")</legend>
            <div class="nhsw-checkboxes">
                @foreach (var value in Enum.GetValues<PhysicalFinding>())
                {
                    <div class="nhsw-checkboxes__item">
                        <input class="nhsw-checkboxes__input" id="@($"finding-{value}")" type="checkbox" name="finding" value="@value" checked="@filter.Findings.Contains(value)" />
                        <label class="nhsw-label nhsw-checkboxes__label" for="@($"finding-{value}")">@T(FindingLabel(value))</label>
                    </div>
                }
            </div>
        </fieldset>
    </div>
    <div class="nhsw-form-group">
        <fieldset class="nhsw-fieldset"><legend class="nhsw-fieldset__legend nhsw-h3">@T("Inclusive contact-date range")</legend>
            <div class="nhsw-form-group">
                <label class="nhsw-label" for="from">@T("From contact date")</label>
                <input class="nhsw-input nhsw-input--width-10" id="from" name="from" type="date" value="@filter.From?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="nhsw-form-group">
                <label class="nhsw-label" for="to">@T("To contact date")</label>
                <input class="nhsw-input nhsw-input--width-10" id="to" name="to" type="date" value="@filter.To?.ToString("yyyy-MM-dd")" />
            </div>
        </fieldset>
    </div>
    <div class="nhsw-form-group">
        <fieldset class="nhsw-fieldset"><legend class="nhsw-fieldset__legend nhsw-h3">@T("Location")</legend>
            <div class="nhsw-checkboxes">
                @foreach (var c in choices.Locations)
                {
                    <div class="nhsw-checkboxes__item">
                        <input class="nhsw-checkboxes__input" id="@($"location-{c.Code}")" type="checkbox" name="location" value="@c.Code" checked="@filter.Locations.Contains(c.Code)" />
                        <label class="nhsw-label nhsw-checkboxes__label" for="@($"location-{c.Code}")">@c.Description</label>
                    </div>
                }
            </div>
        </fieldset>
    </div>
    <div class="nhsw-form-group">
        <fieldset class="nhsw-fieldset"><legend class="nhsw-fieldset__legend nhsw-h3">@T("Examiner")</legend>
            <div class="nhsw-checkboxes">
                @foreach (var c in choices.Examiners)
                {
                    <div class="nhsw-checkboxes__item">
                        <input class="nhsw-checkboxes__input" id="@($"examiner-{c.Code}")" type="checkbox" name="examiner" value="@c.Code" checked="@filter.Examiners.Contains(c.Code)" />
                        <label class="nhsw-label nhsw-checkboxes__label" for="@($"examiner-{c.Code}")">@c.Description</label>
                    </div>
                }
            </div>
        </fieldset>
    </div>
    <div class="nhsw-form-group">
        <label class="nhsw-label" for="size">@T("Results per page")</label>
        <select class="nhsw-select" id="size" name="size">@foreach (var size in new[] { 10, 25, 50 }) { <option value="@size" selected="@(filter.PageSize == size)">@size</option> }</select>
    </div>
    <button class="nhsw-button nhsw-button--primary nhsw-button--inline" type="submit">@T("Apply filters and page size")</button>
    <a class="nhsw-link" href="/results">@T("Clear all filters")</a>
    </fieldset>
</form>
<section aria-labelledby="active-filters"><h2 id="active-filters" class="nhsw-h3">@T("Active filters")</h2><p>@Summary()</p></section>
<p role="status">@F("Showing {0}–{1} of {2} results.", results.First, results.Last, results.Total)</p>
@if (results.Total == 0)
{
    <p>@T(HasFilters ? "No saved KD03 results match the selected filters." : "No saved KD03 results for the selected patient.")</p>
}
else
{
    @foreach (var result in results.Rows)
    {
        <article aria-label="@F("6–8-week contact on {0}", ResultDisplay.Date(result.ExaminationDate))">
            <h2 class="nhsw-h3">@ResultDisplay.Date(result.ExaminationDate) — @T("6–8-week contact")</h2>
            <dl class="nhsw-summary-list nhsw-summary-list--no-border">
                <div class="nhsw-summary-list__row"><dt class="nhsw-summary-list__key">@T("Examination state")</dt><dd class="nhsw-summary-list__value">@T(result.ReasonNotExamined == null ? "Recorded" : "Not examined")</dd></div>
                <div class="nhsw-summary-list__row"><dt class="nhsw-summary-list__key">@T("Location")</dt><dd class="nhsw-summary-list__value">@T(PatientBannerValues.Present(result.LocationName))</dd></div>
                <div class="nhsw-summary-list__row"><dt class="nhsw-summary-list__key">@T("Examiner")</dt><dd class="nhsw-summary-list__value">@T(PatientBannerValues.Present(result.ExaminerName))</dd></div>
                <div class="nhsw-summary-list__row"><dt class="nhsw-summary-list__key">@T("Initial or repeat")</dt><dd class="nhsw-summary-list__value">@T(result.IsRepeat ? "Repeat" : "Initial")</dd></div>
                <div class="nhsw-summary-list__row"><dt class="nhsw-summary-list__key">@T("Recorded date")</dt><dd class="nhsw-summary-list__value">@ResultDisplay.Date(Kd03ResultsQuery.RecordedDate(result))</dd></div>
            </dl>
            <p><a class="nhsw-link" href="@($"/results/{result.PkChildExaminationId}{Navigation.ToAbsoluteUri(ResultsUrlState.Url(filter)).Query}")">@T("View details")<span class="nhsw-visually-hidden">@F(" for 6–8-week contact on {0}", ResultDisplay.Date(result.ExaminationDate))</span></a></p>
        </article>
    }
    <nav class="nhsw-pagination nhsw-pagination--numbered" aria-label="@T("Results pages")">
        @if (results.Page > 1)
        {
            <a class="nhsw-pagination__previous" rel="prev" href="@ResultsUrlState.Url(filter, results.Page - 1)"><span class="nhsw-pagination__title">@T("Previous page")</span></a>
        }
        <ul class="nhsw-pagination__list">
            @for (var i = 1; i <= results.Pages; i++)
            {
                var page = i;
                <li class="@(page == results.Page ? "nhsw-pagination__item nhsw-pagination__item--current" : "nhsw-pagination__item")">
                    <a class="nhsw-pagination__number-link" aria-label="@F("Page {0}", page)" aria-current="@(page == results.Page ? "page" : null)" href="@ResultsUrlState.Url(filter, page)">@(page)</a>
                </li>
            }
        </ul>
        @if (results.Page < results.Pages)
        {
            <a class="nhsw-pagination__next" rel="next" href="@ResultsUrlState.Url(filter, results.Page + 1)"><span class="nhsw-pagination__title">@T("Next page")</span></a>
        }
    </nav>
}
@code {
    ElementReference filterHeading;
    async Task FocusFilters() => await filterHeading.FocusAsync();
    bool ready;
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { ready = true; StateHasChanged(); }
    }
    ResultsPage results;
    ResultsFilter filter = new();
    ResultsChoices choices;
    string[] notices = [];
    protected override void OnInitialized() { base.OnInitialized(); Navigation.LocationChanged += LocationChanged; }
    void LocationChanged(object sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        _ = InvokeAsync(() => { Refresh(); StateHasChanged(); });
    }
    public override void Dispose() { Navigation.LocationChanged -= LocationChanged; base.Dispose(); }
    protected override void OnParametersSet() => Refresh();
    void Refresh()
    {
        choices = Query.Choices(RecordingPageModel.SelectedPatient);
        var state = ResultsUrlState.Parse(Navigation.Uri, choices);
        results = Query.Search(RecordingPageModel.SelectedPatient, state.Filter);
        notices = state.Notices;
        if (results.Page != state.Filter.Page) notices = [.. notices, "Page outside result range; showing the nearest valid page."];
        filter = state.Filter with { Page = results.Page };
    }
    static string FindingLabel(PhysicalFinding f) => f switch { PhysicalFinding.NotAssessed => "Not assessed", PhysicalFinding.HasConcern => "Has concern", _ => f.ToString() };
    bool HasFilters => filter.States.Length + filter.Repeats.Length + filter.Findings.Length + filter.Locations.Length + filter.Examiners.Length > 0 || filter.From.HasValue || filter.To.HasValue;
    string Notice(string notice)
    {
        foreach (var key in new[] { "state", "repeat", "finding", "location", "examiner", "from", "to", "page", "size" })
        {
            foreach (var template in new[] { "Invalid or unavailable {0} values ignored.", "Invalid {0} date ignored.", "Invalid {0} ignored." })
                if (notice == string.Format(template, key)) return F(template, T(key));
        }
        return T(notice);
    }
    string Summary()
    {
        var parts = new List<string>();
        parts.AddRange(filter.States.Select(v => T(v == ExaminationState.Recorded ? "Recorded" : "Not examined")));
        parts.AddRange(filter.Repeats.Select(v => T(v ? "Repeat" : "Initial")));
        parts.AddRange(filter.Findings.Select(v => T(FindingLabel(v))));
        parts.AddRange(choices.Locations.Where(c => filter.Locations.Contains(c.Code)).Select(c => T("Location: ") + c.Description));
        parts.AddRange(choices.Examiners.Where(c => filter.Examiners.Contains(c.Code)).Select(c => T("Examiner: ") + c.Description));
        if (filter.From.HasValue) parts.Add(T("From: ") + ResultDisplay.Date(filter.From.Value.ToDateTime(TimeOnly.MinValue)));
        if (filter.To.HasValue) parts.Add(T("To: ") + ResultDisplay.Date(filter.To.Value.ToDateTime(TimeOnly.MinValue)));
        return parts.Count == 0 ? T("None") : string.Join("; ", parts);
    }
}
