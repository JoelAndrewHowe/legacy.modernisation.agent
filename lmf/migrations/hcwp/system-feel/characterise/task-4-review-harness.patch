+#!/usr/bin/env python3
+"""From repository root: lmf/migrations/hcwp/system-feel/characterise/verify
+Reruns require a fresh --evidence-prefix; retained evidence is never overwritten.
+"""
+import runpy
+import sys
+from pathlib import Path
+sys.dont_write_bytecode = True
+runpy.run_path(str(Path(__file__).resolve().parent / 'reference/run.py'), run_name='__main__')
