#!/usr/bin/env python3
"""Task-5 language inventory/retention plus carried-forward checks; not final slice acceptance."""
import argparse
from datetime import datetime, timezone
import hashlib
import json
from pathlib import Path
import re
import subprocess

HERE = Path(__file__).resolve().parent
TARGET = HERE.parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--evidence-dir', required=True)
args = parser.parse_args()
evidence = Path(args.evidence_dir).resolve()
if not evidence.is_relative_to(HERE / 'evidence'):
    parser.error('Evidence must be under system-feel/refactor/evidence')
evidence.mkdir(parents=True, exist_ok=False)
report = dict(startedAt=datetime.now(timezone.utc).isoformat(), commands=[], errors=[], passed=False,
              suppliedValidatorFindings=[], scope='Task 5 only; expanded bilingual accessibility and final slice gates remain later tasks')
def run(argv, log):
    p = subprocess.run(argv, cwd=TARGET, capture_output=True, text=True)
    (evidence / log).write_text(p.stdout + p.stderr)
    report['commands'].append(dict(argv=argv, cwd=str(TARGET), exitCode=p.returncode, log=log))
    if p.returncode:
        raise RuntimeError('Command failed: ' + ' '.join(argv))
def counts(file, minimum):
    data = json.loads(file.read_text())
    if not (data['passed'] >= minimum and data['total'] == data['passed'] and data['failed'] == 0 and data['skipped'] == 0):
        raise ValueError('Empty/failed/skipped evidence: ' + str(file))
    return {k: data[k] for k in ('total', 'passed', 'failed', 'skipped')}
try:
    run(['git', 'status', '--short'], 'working-tree-before.log')
    run([str(HERE / 'verify-task-4'), '--evidence-dir', str(evidence / 'regression')], 'regression.log')
    regression = json.loads((evidence / 'regression/results.json').read_text())
    if regression['passed'] is not True or regression['errors']:
        raise ValueError('Carried-forward checks failed')
    inventory = json.loads((TARGET / 'refactor/src/Presentation/interface-strings.cy.json').read_text())
    literals = []
    for path in (TARGET / 'refactor/src/Components').rglob('*.razor'):
        for key in re.findall(r'\b[TF]\("([^"\n]+)"', path.read_text()):
            if key not in inventory:
                raise ValueError('Uninventoried interface literal: ' + key)
            literals.append(dict(path=str(path.relative_to(TARGET)), english=key))
    if len(literals) < 80:
        raise ValueError('Empty/incomplete markup inventory scan')
    resources = HERE / 'unresolved-resources.json'
    authority = HERE.parent / 'characterise/resource-reconciliation.json'
    if resources.read_bytes() != authority.read_bytes():
        raise ValueError('Unresolved resource review inventory differs from approved reconciliation')
    report['inventory'] = dict(strings=len(inventory), literalUses=len(literals), unresolvedResources=len(json.loads(resources.read_text())['entries']))
    (evidence / 'inventory-uses.json').write_text(json.dumps(literals, indent=2) + '\n')
    run(['dotnet', 'run', '--project', 'refactor/checks', '--no-build', '--', '--language', 'refactor/src/Presentation/interface-strings.cy.json'], 'language-unit.json')
    report['unit'] = counts(evidence / 'language-unit.json', 7)
    run(['node', 'refactor/browser/language.mjs', str(evidence / 'browser')], 'browser.log')
    report['browser'] = counts(evidence / 'browser/results.json', 6)
    run(['dotnet', '--info'], 'dotnet-info.log')
    run(['node', '--version'], 'node-version.log')
    run(['git', 'diff', '--check', '--', 'refactor', 'system-feel/refactor'], 'diff-check.log')
    run(['git', 'status', '--short'], 'working-tree-after.log')
    report['passed'] = True
except Exception as error:
    report['errors'].append(str(error))
finally:
    files = [p for folder in ('refactor/src', 'refactor/checks', 'refactor/browser')
             for p in (TARGET / folder).rglob('*') if p.is_file()
             and not any(part in ('bin', 'obj', 'node_modules') for part in p.relative_to(TARGET).parts)]
    files += [Path(__file__).resolve(), HERE / 'task-5.md', HERE / 'unresolved-resources.json']
    (evidence / 'source-identities.sha256').write_text(''.join(
        f'{hashlib.sha256(p.read_bytes()).hexdigest()}  {p.relative_to(TARGET)}\n' for p in sorted(files)))
    report['finishedAt'] = datetime.now(timezone.utc).isoformat()
    (evidence / 'results.json').write_text(json.dumps(report, indent=2) + '\n')
    files = sorted(p for p in evidence.rglob('*') if p.is_file())
    (evidence / 'evidence-identities.sha256').write_text(''.join(
        f'{hashlib.sha256(p.read_bytes()).hexdigest()}  {p.relative_to(TARGET)}\n' for p in files))
    print(json.dumps(report))
raise SystemExit(0 if report['passed'] else 1)
