digraph assembly_line {
  start -> planner
  planner -> doer           [label="not complete"]
  planner -> finish         [label="complete"]
  doer -> validator
  validator -> doer         [label="not satisfied"]
  validator -> oo-validator [label="satisfied"]
  oo-validator -> doer      [label="not satisfied"]
  oo-validator -> ux-designer [label="satisfied"]
  ux-designer -> doer       [label="not satisfied"]
  ux-designer -> planner    [label="satisfied"]
}
