/factory/runs/

# Generated downloads and publish outputs
/artifacts/

# Build and restored dependency outputs
**/bin/
**/obj/
**/node_modules/

# The repository's launcher scripts are source, not build output.
!/bin/
!/bin/**

# Each machine keeps its own copy of your login (homework 5a). Never
# commit one. Your factory should keep them out of Git too; this is a
# safety net.
**/.machines/*/auth.json
**/.machines/*/.credentials.json
