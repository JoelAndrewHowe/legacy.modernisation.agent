#!/usr/bin/env python3
"""Resolve bounded BDD and guidance references from one active plan task."""

import hashlib
import json
import pathlib
import re
import subprocess
import sys


def response(ready: bool, context: str = "", findings: list[str] | None = None) -> None:
    print(json.dumps({"ready": ready, "context": context, "findings": findings or []}))


def repository_root() -> pathlib.Path:
    found = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        cwd=pathlib.Path.cwd(), capture_output=True, text=True, check=False
    )
    return pathlib.Path(found.stdout.strip()).resolve() if found.returncode == 0 else pathlib.Path.cwd().resolve()


def slug(value: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")


def json_items(value):
    if isinstance(value, dict):
        if isinstance(value.get("id"), str):
            yield value
        for child in value.values():
            yield from json_items(child)
    elif isinstance(value, list):
        for child in value:
            yield from json_items(child)


def select_json(path: pathlib.Path, selectors: list[str]) -> str:
    document = json.loads(path.read_text(encoding="utf-8"))
    indexed = {item["id"]: item for item in json_items(document)}
    missing = [selector for selector in selectors if selector not in indexed]
    if missing:
        raise ValueError(f"scenario IDs not found: {', '.join(missing)}")
    return json.dumps([indexed[selector] for selector in selectors], indent=2, ensure_ascii=False)


def select_markdown(path: pathlib.Path, selectors: list[str]) -> str:
    lines = path.read_text(encoding="utf-8").splitlines()
    sections: dict[str, str] = {}
    for wanted in selectors:
        start = None
        level = 0
        for index, line in enumerate(lines):
            heading = re.match(r"^(#{1,6})\s+(.+?)\s*$", line)
            if heading and slug(heading.group(2)) == slug(wanted):
                start = index
                level = len(heading.group(1))
                break
        if start is None:
            raise ValueError(f"Markdown heading not found: {wanted}")
        end = len(lines)
        for index in range(start + 1, len(lines)):
            heading = re.match(r"^(#{1,6})\s+", lines[index])
            if heading and len(heading.group(1)) <= level:
                end = index
                break
        sections[wanted] = "\n".join(lines[start:end]).strip()
    return "\n\n".join(sections.values())


def feature_blocks(text: str) -> list[tuple[set[str], str, str]]:
    lines = text.splitlines()
    starts: list[int] = []
    for index, line in enumerate(lines):
        if re.match(r"^\s*(Scenario(?: Outline)?|Example):", line):
            start = index
            probe = index - 1
            while probe >= 0 and (not lines[probe].strip() or lines[probe].lstrip().startswith("@")):
                if lines[probe].lstrip().startswith("@"): start = probe
                probe -= 1
            starts.append(start)
    blocks = []
    for position, start in enumerate(starts):
        end = starts[position + 1] if position + 1 < len(starts) else len(lines)
        block = "\n".join(lines[start:end]).strip()
        tags = set(re.findall(r"@[A-Za-z0-9_-]+", block.split("Scenario", 1)[0]))
        heading = next((line.strip() for line in lines[start:end]
                        if re.match(r"^\s*(Scenario(?: Outline)?|Example):", line)), "")
        blocks.append((tags, heading, block))
    return blocks


def select_feature(path: pathlib.Path, selectors: list[str]) -> str:
    text = path.read_text(encoding="utf-8")
    blocks = feature_blocks(text)
    selected = []
    missing = []
    for selector in selectors:
        matches = [block for tags, heading, block in blocks
                   if (selector.startswith("@") and selector in tags)
                   or (not selector.startswith("@") and selector.lower() in heading.lower())]
        if not matches:
            missing.append(selector)
        for match in matches:
            if match not in selected: selected.append(match)
    if missing:
        raise ValueError(f"Gherkin selectors not found: {', '.join(missing)}")
    feature = next((line for line in text.splitlines() if line.lstrip().startswith("Feature:")), "Feature: Selected acceptance")
    return feature + "\n\n" + "\n\n".join(selected)


prompt = " ".join(sys.argv[1:]) if len(sys.argv) > 1 else sys.stdin.read()
task_match = re.search(r"ACTIVE_TASK_BEGIN\n(.*?)\nACTIVE_TASK_END", prompt, re.DOTALL)
if not task_match:
    response(False, findings=["The review-context prompt did not contain an active task."])
    raise SystemExit(0)

task = task_match.group(1)
reference_lines = re.findall(
    r"^\s*-\s*(Acceptance|BDD|Guidance|Context):\s*(.+)$", task, re.IGNORECASE | re.MULTILINE
)
references: list[tuple[str, str]] = []
for kind, value in reference_lines:
    references.extend((kind.lower(), reference) for reference in re.findall(r"`([^`]+)`", value))

if not references:
    response(False, findings=[
        "The active task must cite at least one bounded local contract reference on an indented "
        "Acceptance: or Guidance: line, for example `path/scenarios.json#CASE-001` or "
        "`path/guidance.md#section-heading`."
    ])
    raise SystemExit(0)

root = repository_root()
blocks = []
findings = []
for kind, reference in references:
    if "#" not in reference:
        findings.append(f"Reference must include a bounded selector after #: {reference}")
        continue
    raw_path, raw_selectors = reference.rsplit("#", 1)
    selectors = [item.strip() for item in raw_selectors.split(",") if item.strip()]
    path = (pathlib.Path.cwd() / raw_path).resolve()
    try:
        path.relative_to(root)
    except ValueError:
        findings.append(f"Reference is outside the repository: {reference}")
        continue
    if not path.is_file():
        findings.append(f"Referenced context file does not exist: {reference}")
        continue
    if not selectors:
        findings.append(f"Reference has no selector: {reference}")
        continue
    try:
        if path.suffix.lower() == ".json":
            content = select_json(path, selectors)
        elif path.suffix.lower() in {".feature", ".gherkin"}:
            content = select_feature(path, selectors)
        elif path.suffix.lower() in {".md", ".markdown"}:
            content = select_markdown(path, selectors)
        else:
            raise ValueError("supported context types are JSON scenarios, Gherkin features, and Markdown guidance")
    except (OSError, ValueError, json.JSONDecodeError) as error:
        findings.append(f"Could not resolve {reference}: {error}")
        continue
    digest = hashlib.sha256(path.read_bytes()).hexdigest()
    relative = path.relative_to(root)
    blocks.append(
        f"--- {kind.upper()}: {relative}#{raw_selectors} (sha256:{digest}) ---\n{content}"
    )

if findings:
    response(False, findings=findings)
else:
    response(True, context="\n\n".join(blocks))
