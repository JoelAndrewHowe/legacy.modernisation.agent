#!/usr/bin/env python3
"""Run one factory reviewer through OpenRouter without exposing its API key."""

from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path


def local_api_key() -> str | None:
    key = os.environ.get("OPENROUTER_API_KEY")
    if key:
        return key

    secrets = Path(__file__).resolve().parents[1] / ".env.openrouter"
    if not secrets.exists():
        return None
    for raw_line in secrets.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        name, value = line.split("=", 1)
        if name.strip() == "OPENROUTER_API_KEY":
            return value.strip().strip('"').strip("'")
    return None


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--model", required=True)
    parser.add_argument("prompt", nargs="?")
    args = parser.parse_args()
    prompt = args.prompt if args.prompt is not None else sys.stdin.read()
    if not prompt.strip():
        parser.error("a prompt argument or standard input is required")

    api_key = local_api_key()
    if not api_key or api_key == "sk-or-v1-replace-me":
        print(
            "OPENROUTER_API_KEY is not set. Copy .env.openrouter.example to "
            ".env.openrouter and add your key, or export it in the shell.",
            file=sys.stderr,
        )
        return 2

    endpoint = os.environ.get(
        "OPENROUTER_API_URL", "https://openrouter.ai/api/v1/chat/completions"
    )
    body = json.dumps(
        {
            "model": args.model,
            "temperature": 0.1,
            "response_format": {"type": "json_object"},
            "messages": [
                {
                    "role": "system",
                    "content": (
                        "You are one machine in a software factory. Follow the "
                        "review instructions exactly. Return only the requested "
                        "JSON object, with no Markdown fence or commentary."
                    ),
                },
                {"role": "user", "content": prompt},
            ],
        }
    ).encode("utf-8")
    request = urllib.request.Request(
        endpoint,
        data=body,
        method="POST",
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
            "HTTP-Referer": "https://github.com/openai/legacy-modernisation-agent",
            "X-Title": "Legacy Modernisation Factory",
        },
    )

    try:
        with urllib.request.urlopen(request, timeout=300) as response:
            payload = json.load(response)
        content = payload["choices"][0]["message"]["content"]
        if not isinstance(content, str) or not content.strip():
            raise ValueError("OpenRouter returned no text content")
        print(content.strip())
        return 0
    except urllib.error.HTTPError as error:
        detail = error.read().decode("utf-8", errors="replace")
        print(f"OpenRouter returned HTTP {error.code}: {detail}", file=sys.stderr)
    except (urllib.error.URLError, TimeoutError, KeyError, ValueError, json.JSONDecodeError) as error:
        print(f"OpenRouter request failed: {error}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
